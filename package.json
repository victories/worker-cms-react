{
  "name": "wp-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "build:css": "node scripts/build-public-css.mjs",
    "deploy": "npm run build:css && wrangler deploy",
    "db:create": "wrangler d1 create cms-db-v2",
    "db:migrate:local": "wrangler d1 execute cms-db-v2 --local --file=src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute cms-db-v2 --local --file=src/db/seed.sql",
    "db:migrate": "wrangler d1 execute cms-db-v2 --remote --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute cms-db-v2 --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "postcss": "^8.5.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "wrangler": "^3.109.0"
  }
}
