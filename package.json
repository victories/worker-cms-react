{
  "name": "wp-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:assets && wrangler dev",
    "build:css": "node scripts/build-public-css.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:assets": "npm run build:css && npm run build:client",
    "deploy": "npm run build:assets && wrangler deploy",
    "db:create": "wrangler d1 create cms-db-v2",
    "db:migrate:local": "wrangler d1 execute cms-db-v2 --local --file=src/db/schema.sql",
    "db:seed:local": "wrangler d1 execute cms-db-v2 --local --file=src/db/seed.sql",
    "db:migrate": "wrangler d1 execute cms-db-v2 --remote --file=src/db/schema.sql",
    "db:seed": "wrangler d1 execute cms-db-v2 --remote --file=src/db/seed.sql"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "framer-motion": "^11.18.2",
    "hono": "^4.7.0",
    "lenis": "^1.3.23",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "postcss": "^8.5.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "wrangler": "^3.109.0"
  }
}
